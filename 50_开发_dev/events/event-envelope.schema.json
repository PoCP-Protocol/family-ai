{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FamilyDomainEventEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventName",
    "eventVersion",
    "aggregateType",
    "aggregateId",
    "occurredAt",
    "correlationId",
    "actor",
    "source",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventName": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]+$"
    },
    "eventVersion": {
      "type": "integer",
      "minimum": 1
    },
    "aggregateType": {
      "type": "string"
    },
    "aggregateId": {
      "type": "string"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string"
    },
    "causationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "actor": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "PARENT",
            "CHILD",
            "STAFF",
            "SYSTEM",
            "AI"
          ]
        },
        "id": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    }
  }
}
