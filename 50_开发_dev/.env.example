# 复制为 .env(勿提交)。docker-compose 起本地 PG 后可直接用下值。
PORT=3000
DATABASE_URL=postgres://family:family@localhost:5432/family_dev

# --- FPAI Model Provider(经 cc switch / CCR,OpenAI 兼容)---
# 【M3-101A 边界】本阶段 Provider 运行时保持 FakeAiGateway;REAL_EXTERNAL_MODEL_CALL=NOT_AUTHORIZED。
# 以下仅占位说明"如何接 cc switch";真实 key 只在 101A-B 经架构师授权后放本地 .env(已 gitignore),严禁入库。
# FPAI_MODEL_BASE_URL=http://127.0.0.1:<ccswitch_port>/v1
# FPAI_MODEL_API_KEY=<PLACEHOLDER_DO_NOT_COMMIT_REAL_KEY>
# FPAI_MODEL_NAME=<model-name-routed-by-cc-switch>
# FPAI_MODEL_TIMEOUT_MS=30000

# --- Family Education Model Gateway(UI-02/UI-03 内部/本地显式授权)---
# 默认仍 fail-closed:mock/零外呼。只有在 AUTHORIZATION_REGISTRY 的
# G1A_FAMILY_EDUCATION_ASSESSMENT_MODEL_INTERNAL 范围内,且本地 .env 显式开启时,才允许经 Model Gateway 调 cc switch。
# 真实 key 只能由人直接写入本地 .env,不要发到聊天、文档、git 或日志。
FAMILY_MODEL_GATEWAY_MODE=mock
FAMILY_MODEL_ALLOW_LIVE_EXTERNAL_AI=false
# FAMILY_MODEL_LIVE_AUTHORIZED=false

# 内部/本地真实模型示例(按需取消注释到本地 .env,勿提交):
# FAMILY_MODEL_GATEWAY_MODE=cc-switch
# FAMILY_MODEL_ALLOW_LIVE_EXTERNAL_AI=true
# FAMILY_MODEL_LIVE_AUTHORIZED=true
# FAMILY_MODEL_CC_SWITCH_API_KIND=codex
# FAMILY_MODEL_CC_SWITCH_PROVIDER_ID=codex-cc-switch
# FAMILY_MODEL_CODEX_BASE_URL=http://127.0.0.1:<ccswitch_port>/v1
# FAMILY_MODEL_CODEX_API_KEY=<PLACEHOLDER_DO_NOT_COMMIT_REAL_KEY>
# FAMILY_MODEL_CODEX_MODEL=<codex-model-name-routed-by-cc-switch>
# FAMILY_MODEL_CC_SWITCH_BASE_URL=http://127.0.0.1:<ccswitch_port>/v1
# FAMILY_MODEL_CC_SWITCH_API_KEY=<PLACEHOLDER_DO_NOT_COMMIT_REAL_KEY>
# FAMILY_MODEL_CC_SWITCH_MODEL=<model-name-routed-by-cc-switch>
# FAMILY_MODEL_CC_SWITCH_TIMEOUT_MS=30000

# 可选:多 API 蒸馏路由,仍必须经 Family Model Gateway 工具和 run-scoped --live-authorized。
# 不配置 ROUTE_N 时会使用上面的 FAMILY_MODEL_CC_SWITCH_* 单路由配置。
# FAMILY_MODEL_MULTI_API_ROUTE_1_PROVIDER_ID=codex-cc-switch
# FAMILY_MODEL_MULTI_API_ROUTE_1_KIND=openai-compatible
# FAMILY_MODEL_MULTI_API_ROUTE_1_BASE_URL=http://127.0.0.1:<ccswitch_port>/v1
# FAMILY_MODEL_MULTI_API_ROUTE_1_API_KEY=<PLACEHOLDER_DO_NOT_COMMIT_REAL_KEY>
# FAMILY_MODEL_MULTI_API_ROUTE_1_MODEL=<model-name-routed-by-cc-switch>
# FAMILY_MODEL_MULTI_API_ROUTE_2_PROVIDER_ID=anthropic-cc-switch
# FAMILY_MODEL_MULTI_API_ROUTE_2_KIND=anthropic-compatible
# FAMILY_MODEL_MULTI_API_ROUTE_2_BASE_URL=http://127.0.0.1:<ccswitch_port>
# FAMILY_MODEL_MULTI_API_ROUTE_2_API_KEY=<PLACEHOLDER_DO_NOT_COMMIT_REAL_KEY>
# FAMILY_MODEL_MULTI_API_ROUTE_2_MODEL=<model-name-routed-by-cc-switch>
